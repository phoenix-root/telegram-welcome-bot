# Telegram Bot Token (Get from @BotFather on Telegram)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Timezone for scheduled greetings (Default: Asia/Kolkata for IST)
# Change to your local timezone if needed, e.g. UTC, America/New_York, Europe/London
TIMEZONE=Asia/Kolkata

# Port for Keep-Alive Web Server (Render/Railway/Koyeb assigns PORT automatically)
PORT=3000

# Optional: Custom Cron Schedule for greetings (Minute Hour Day Month DayOfWeek)
# 08:00 AM Daily
CRON_MORNING=0 8 * * *
# 01:00 PM Daily (13:00)
CRON_AFTERNOON=0 13 * * *
# 06:00 PM Daily (18:00)
CRON_EVENING=0 18 * * *
